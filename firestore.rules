rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Funcions de suport del motor de regles de Firestore
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Filtre d'identificador segur i lliure d'injecció
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Rol d'administració autoritzat directament per a accés Backoffice d'OposiCAT
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "xepfarre@gmail.com" ||
        request.auth.token.email == "xepfarre7@gmail.com" ||
        request.auth.token.email == "sergivinu@gmail.com" ||
        (exists(/databases/$(database)/documents/usuaris/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/usuaris/$(request.auth.uid)).data.rol == "admin" ||
          get(/databases/$(database)/documents/usuaris/$(request.auth.uid)).data.rol == "admin_master"))
      );
    }

    // Validador robust per evitar actualitzacions parcials invàlides de tokens de dispositiu
    function isValidFCMToken(data) {
      return data.keys().hasAll(['userId', 'email', 'token', 'plataforma', 'creadaEl']) &&
             data.keys().size() == 5 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.token is string && data.token.size() <= 512 &&
             data.plataforma is string && (data.plataforma == "android" || data.plataforma == "ios" || data.plataforma == "web_pc");
    }

    // 1. Col·lecció principal dels usuaris autenticats a OposiCAT (en català)
    match /usuaris/{userId} {
      
      // Permetem lectura del perfil si és l'amo de les dades o administrador
      allow get: if isOwner(userId) || isAdmin();
      
      // Prohibim a estudiants llistar tots els companys per privacitat
      allow list: if isAdmin();

      // CREACIÓ DE FITXA DES DE ZERO:
      // S'assegura que un nouvingut es registri amb un rol vàlid de l'organigrama d'OposiCAT i els camps obligatoris
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().uid == request.auth.uid &&
                       incoming().email is string &&
                       incoming().displayName is string &&
                       (incoming().rol == "opositor" || incoming().rol == "usuari_free_trial" || incoming().rol == "admin" || incoming().rol == "admin_master") &&
                       (incoming().haPagat == true || incoming().haPagat == false) &&
                       incoming().estatSubscripcio is string &&
                       (incoming().correuVerificat == true || incoming().correuVerificat == false);

      // ACTUALITZACIÓ DE FITXA EN TEMPS REAL:
      // Comentari planer per a no-programadors:
      // Es permet a l'alumne canviar o actualitzar el seu propi document de dades però protegim completament
      // la immutabilitat dels camps sensibles: el rol d'estudiant, el correu i l'estat del pagament real.
      allow update: if (isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().rol == existing().rol &&
                       incoming().haPagat == existing().haPagat &&
                       incoming().estatSubscripcio == existing().estatSubscripcio &&
                       incoming().correuVerificat == existing().correuVerificat &&
                       (!("idSessioActiva" in incoming()) || (incoming().idSessioActiva is string && incoming().idSessioActiva.size() <= 128)) &&
                       (!("displayName" in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 128)) &&
                       (!("photoURL" in incoming()) || (incoming().photoURL is string && incoming().photoURL.size() <= 512))
                      ) || 
                      isAdmin();

      // Només d'esborrat des del Backoffice d'OposiCAT
      allow delete: if isAdmin();

      // 1.1 Subcol·lecció de dades de facturació i de privacitat RGPD (dades_privades)
      match /dades_privades/{docId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();
        
        // Permetre crear-se el seu primer calaix de facturació securitzat
        allow create: if isOwner(userId) &&
                         isValidId(docId) &&
                         incoming().uid == userId;

        // Permetre modificar dades personals lliurement pel propietari
        allow update: if (isOwner(userId) && 
                         incoming().uid == userId && 
                         incoming().uid == existing().uid) || 
                         isAdmin();

        allow delete: if isAdmin();
      }

      // 1.2 Subcol·lecció de tokens FCM per a rebre notificacions push al smartphone
      match /tokens_fcm/{tokenId} {
        allow get, write: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();
      }
    }

    // 2. Col·lecció de Rols i configuracions de permisos per a l'organització interna
    match /rols/{rolId} {
      // Qualsevol usuari autenticat pot llegir quins rols i permisos generals existeixen
      allow read: if isSignedIn();
      
      // Només l'administrador autenticat oficial d'OposiCAT pot modificar la taula de rols i permisos
      allow write: if isAdmin();
    }

    // 3. Historial de canvis d'auditoria de rols per als administradors (logs_rols)
    match /logs_rols/{logId} {
      allow read, write: if isAdmin();
    }

    // 4. Col·lecció global de Notificacions enviades i programades de l'administració
    match /notificacions/{notificacioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Nova col·lecció global de registre de tokens FCM reals dels mòbils (fcm_tokens)
    match /fcm_tokens/{tokenId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 20 && request.query.filters.userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(tokenId) &&
                       isValidFCMToken(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().email == request.auth.token.email &&
                       incoming().creadaEl == request.time;
      allow update: if (isSignedIn() &&
                       isValidId(tokenId) &&
                       isValidFCMToken(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       existing().userId == request.auth.uid &&
                       incoming().email == request.auth.token.email &&
                       incoming().creadaEl == existing().creadaEl) || 
                       isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 6. Col·lecció de banc de preguntes globals (permetem llegir de forma lliure per evitar errors de càrrega)
    // Comentari planer per a no-programadors: Deixem llegir les preguntes de l'examen a qualsevol persona que entri, ja que són dades d'estudi públiques, però només deixem que els administradors oficials puguin modificar o crear preguntes noves.
    match /preguntes_codificades/{preguntaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Suport per a consultes CollectionGroup sobre preguntes_codificades
    // Comentari planer per a no-programadors: Això ajuda al cercador intern de l'aplicació a trobar qualsevol pregunta independentment de la carpeta o subtema on s'hagi guardat originalment.
    match /{path=**}/preguntes_codificades/{preguntaId} {
      allow read: if true;
    }

    // 7. Col·lecció de preguntes ordenades per exàmens oficials i simulacres
    // Comentari planer per a no-programadors: Les preguntes i respostes dels exàmens reals i simulacres s'han d'ensenyar tant als alumnes registrats com als usuaris de prova ràpida. Bloquegem l'escriptura per seguretat.
    match /examens/{examenId}/preguntes/{preguntaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Col·lecció d'Actualitat i Notícies de la Setmana
    // Comentari planer per a no-programadors: La llista de notícies, canvis de bases de convocatòria i novetats s'ha de poder llegir lliurement. Només es pot escriure per l'administració autoritzada de la web.
    match /actualitat/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Banc de preguntes d'actualitat relacionades a les notícies
    // Comentari planer per a no-programadors: Permet als opositors assajar preguntes basades en les darreres notícies i canvis legislatius d'OposiCAT.
    match /actualitat_preguntes/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Directori d'acadèmies i gimnasos de preparació física
    // Comentari planer per a no-programadors: Informació de suport amb els gimnasos col·laboradors per preparar les proves físiques. De lectura lliure, tancat d'escriptura als alumnes.
    match /gimnasos/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Reserves d'assessoria amb l'equip de psicologia clínica d'OposiCAT
    // Comentari planer per a no-programadors: Per demanar cita de simulacres d'entrevista amb psicòlegs, els alumnes registrats poden reservar de forma asíncrona un espai segur. Els administradors tenen accés total per coordinar-ho.
    match /reserves_psicologia/{documentId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // 12. Gestor de taules de subscripcions i llicències
    // Comentari planer per a no-programadors: Informació reservada d'ús purament intern que només pot consultar i gestionar l'equip d'administració de la plataforma.
    match /subscripcions/{documentId} {
      allow read, write: if isAdmin();
    }

    // 13. Banc d'actualització de tipus de psicotècnics d'OposiMossos (figures, sèries, orientació)
    // Comentari planer per a no-programadors: Definicions generals de les competències intel·lectuals necessàries dels tests psicotècnics.
    match /psicotecnics_tipus/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 14. Banc de preguntes psicotècniques d'oposició real
    // Comentari planer per a no-programadors: Les preguntes i exercicis psicotècnics s'exposen gratuïtament o sota subscripció.
    match /psicotecnics_preguntes/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 15. Banc de proves d'exercici físic (pressió sobre banc, llançament, cursa de llançadora)
    // Comentari planer per a no-programadors: Models i barems del que exigeix el cos de Mossos d'Esquadra en cada disciplina física d'accés.
    match /exercicis_fisics/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 16. Plans d'entrenament programats setmana a setmana
    // Comentari planer per a no-programadors: Taules guiades d'entrenaments esportius setmanals adaptables per als alumnes de l'acadèmia.
    match /plans_entrenament/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 17. Preguntes de biodata de tipus personal, laboral i corporatiu de policia
    // Comentari planer per a no-programadors: Preguntes del qüestionari biogràfic obligatori del procés selectiu (biodata). Llegit pel simulador de l'alumne i administrat pel backoffice.
    match /preguntes_biodata_personals/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preguntes_biodata_laborals/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preguntes_biodata_pgme/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 18. Historial d'assajos de preguntes cara a cara en l'entrevista d'accés
    // Comentari planer per a no-programadors: Base de preguntes preparatòries per a l'entrevista oral exhaustiva.
    match /preguntes_entrevista/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19. Col·lecció de seguiment de respostes d'opositors per poder analitzar el progrés fidedignament
    // Comentari planer per a no-programadors: Aquest és el calaix personal de respostes que cada alumne respon. Per privacitat i RGPD, un alumne només pot llegir i desar les seves pròpies respostes realitzades.
    match /usuaris/{userId}/respostes_preguntes/{preguntaId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) &&
                               isValidId(preguntaId) &&
                               incoming().preguntaId == preguntaId &&
                               (incoming().encertada == true || incoming().encertada == false) &&
                               incoming().respostaSeleccionada is int &&
                               incoming().intents is int &&
                               incoming().correctes is int &&
                               incoming().errors is int;
      allow delete: if isAdmin();
    }

    // 20. Estructura de Temari d'Estudi d'OposiCAT
    // Comentari planer per a no-programadors: Permet a qualsevol persona llegir els temaris de Mossos d'Esquadra i les preguntes codificades associades, però restringeix qualsevol petició d'escriptura (creació, actualització i esborrat) exclusivament al personal d'administració autoritzat.
    match /temari/{anyDoc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 21. Comptadors globals de preguntes i temes (comptadors)
    // Comentari planer per a no-programadors: Permet que qualsevol alumne registrat a l'aplicació llegeixi els totals de preguntes dels diferents temes per així determinar correctament i de forma automàtica els seus percentatges de superació o estadístiques. Els canvis d'escriptura queden reservats només per als administradors d'OposiCAT.
    match /comptadors/{comptadorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
