rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Funcions de suport del motor de regles de Firestore
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Filtre d'identificador segur i lliure d'injecció
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Rol d'administració autoritzat directament per a accés Backoffice d'OposiCAT
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "xepfarre@gmail.com" ||
        request.auth.token.email == "xepfarre7@gmail.com" ||
        request.auth.token.email == "sergivinu@gmail.com" ||
        (exists(/databases/$(database)/documents/usuaris/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/usuaris/$(request.auth.uid)).data.rol == "admin" ||
          get(/databases/$(database)/documents/usuaris/$(request.auth.uid)).data.rol == "admin_master" ||
          get(/databases/$(database)/documents/usuaris/$(request.auth.uid)).data.rol == "treballador_nivell_1" ||
          get(/databases/$(database)/documents/usuaris/$(request.auth.uid)).data.rol == "treballador_nivell_2" ||
          get(/databases/$(database)/documents/usuaris/$(request.auth.uid)).data.rol == "treballador_nivell_3"))
      );
    }

    // Validador robust per evitar actualitzacions parcials invàlides de tokens de dispositiu
    function isValidFCMToken(data) {
      return data.keys().hasAll(['userId', 'email', 'token', 'plataforma', 'creadaEl']) &&
             data.keys().size() == 5 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.token is string && data.token.size() <= 512 &&
             data.plataforma is string && (data.plataforma == "android" || data.plataforma == "ios" || data.plataforma == "web_pc");
    }

    // Validador robust per al feedback de dieta enviat pels usuaris d'OposiCAT
    function isValidDietaFeedback(data) {
      return data.keys().hasAll(['usuariId', 'usuariNom', 'usuariEmail', 'tipus', 'alimentNom', 'missatge', 'llegit', 'estat']) &&
             data.usuariId is string && data.usuariId.size() <= 128 &&
             data.usuariNom is string && data.usuariNom.size() <= 128 &&
             data.usuariEmail is string && data.usuariEmail.size() <= 128 &&
             data.alimentNom is string && data.alimentNom.size() <= 128 &&
             data.missatge is string && data.missatge.size() <= 2000 &&
             data.llegit is bool &&
             data.estat is string && (data.estat == "pendent" || data.estat == "resolt" || data.estat == "tramitat") &&
             data.tipus is string && (data.tipus == "suggeriment" || data.tipus == "aliment_erroni" || data.tipus == "aliment_duplicat" || data.tipus == "dubte_general" || data.tipus == "alta_aliment") &&
             (!("respostaAdmin" in data) || (data.respostaAdmin is string && data.respostaAdmin.size() <= 2000)) &&
             (!("kcal" in data) || data.kcal is number) &&
             (!("carbs" in data) || data.carbs is number) &&
             (!("protes" in data) || data.protes is number) &&
             (!("greixos" in data) || data.greixos is number);
    }

    // Validador de propostes de gimnasos enviades pels usuaris o propietaris d'OposiCAT
    function isValidPropostaGimnas(data) {
      return data.keys().hasAll(['usuariId', 'tipusProposta', 'nomSollicitant', 'emailContacte', 'nomGimnas', 'provincia', 'comarca', 'municipi', 'adreca', 'proves', 'estat', 'creatEl']) &&
             data.usuariId is string && data.usuariId.size() <= 128 &&
             data.tipusProposta is string && (data.tipusProposta == "usuari" || data.tipusProposta == "propietari") &&
             data.nomSollicitant is string && data.nomSollicitant.size() <= 256 &&
             data.emailContacte is string && data.emailContacte.size() <= 256 &&
             data.nomGimnas is string && data.nomGimnas.size() <= 256 &&
             data.provincia is string && data.provincia.size() <= 128 &&
             data.comarca is string && data.comarca.size() <= 128 &&
             data.municipi is string && data.municipi.size() <= 128 &&
             data.adreca is string && data.adreca.size() <= 512 &&
             data.proves is list && data.proves.size() <= 10 &&
             data.estat is string && (data.estat == "pendent" || data.estat == "aprovat" || data.estat == "rebutjat" || data.estat == "acceptada" || data.estat == "denegada") &&
             (!("telefonContacte" in data) || (data.telefonContacte is string && data.telefonContacte.size() <= 32)) &&
             (!("comentari" in data) || (data.comentari is string && data.comentari.size() <= 2000)) &&
             (!("tarifes" in data) || (data.tarifes is string && data.tarifes.size() <= 2000)) &&
             (!("descripcio" in data) || (data.descripcio is string && data.descripcio.size() <= 2000));
    }

    // 1. Col·lecció principal dels usuaris autenticats a OposiCAT (en català)
    match /usuaris/{userId} {
      
      // Permetem lectura del perfil si és l'amo de les dades o administrador
      allow get: if isOwner(userId);
      allow get: if isAdmin();
      
      // Prohibim a estudiants llistar tots els companys per privacitat
      allow list: if isAdmin();

      // CREACIÓ DE FITXA DES DE ZERO:
      // S'assegura que un nouvingut es registri amb un rol vàlid de l'organigrama d'OposiCAT i els camps obligatoris
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().uid == request.auth.uid &&
                       incoming().email is string &&
                       (!("displayName" in incoming()) || incoming().displayName is string) &&
                       (incoming().rol is string && incoming().rol.size() <= 64) &&
                       (incoming().haPagat == true || incoming().haPagat == false) &&
                       incoming().estatSubscripcio is string &&
                       (incoming().correuVerificat == true || incoming().correuVerificat == false);

      // ACTUALITZACIÓ DE FITXA EN TEMPS REAL:
      // Comentari planer per a no-programadors:
      // Es permet a l'alumne canviar o actualitzar el seu propi document de dades però protegim completament
      // la immutabilitat dels camps sensibles: el rol d'estudiant, el correu i l'estat del pagament real.
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().rol == existing().rol &&
                       incoming().haPagat == existing().haPagat &&
                       incoming().estatSubscripcio == existing().estatSubscripcio &&
                       incoming().correuVerificat == existing().correuVerificat &&
                       (!("idSessioActiva" in incoming()) || (incoming().idSessioActiva is string && incoming().idSessioActiva.size() <= 128)) &&
                       (!("displayName" in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 128)) &&
                       (!("photoURL" in incoming()) || (incoming().photoURL is string && incoming().photoURL.size() <= 512));
      allow update: if isAdmin();

      // Només d'esborrat des del Backoffice d'OposiCAT
      allow delete: if isAdmin();

      // 1.1 Subcol·lecció de dades de facturació i de privacitat RGPD (dades_privades)
      match /dades_privades/{docId} {
        allow get: if isOwner(userId);
        allow get: if isAdmin();
        allow list: if isAdmin();
        
        // Permetre crear-se el seu primer calaix de facturació securitzat
        allow create: if isOwner(userId) &&
                         isValidId(docId) &&
                         incoming().uid == userId;

        // Permetre modificar dades personals lliurement pel propietari
        allow update: if isOwner(userId) && 
                         incoming().uid == userId && 
                         incoming().uid == existing().uid;
        allow update: if isAdmin();

        allow delete: if isAdmin();
      }

      // 1.2 Subcol·lecció de tokens FCM per a rebre notificacions push al smartphone
      match /tokens_fcm/{tokenId} {
        allow get, write: if isOwner(userId);
        allow get, write: if isAdmin();
        allow list: if isAdmin();
      }

      // 1.3 Subcol·lecció de resum d'estadístiques o agrupació prèvia d'estudis de l'usuari (estadistiques)
      // Comentari planer per a no-programadors: Aquesta col·lecció permet desar la foto resum d'estadístiques i encerts (com el total de respostes i encerts), garantint que la velocitat de càrrega sigui ultra-ràpida directament de forma atòmica sense haver de llegegir milers de files. L'estudiant té accés per llegegir i modificar el seu propi resum.
      match /estadistiques/{docId} {
        allow read: if isOwner(userId);
        allow read: if isAdmin();
        allow write: if isOwner(userId);
        allow write: if isAdmin();
      }

      // 1.4 Subcol·lecció del progrés de lectura detallat i global dels temes de l'oposició
      // Comentari planer per a no-programadors: Permet a l'estudiant registrar quines pàgines té memoritzades o llegides de cadascun dels àmbits d'estudi. Separar la regla de l'estudiant i de l'admin és vital per evitar errors rellevants amb "isAdmin()" en comptes de prova on el perfil encara no està creat completament.
      match /progres_lectura/{docId} {
        allow read, write: if isOwner(userId);
        allow read, write: if isAdmin();
      }

      // 1.5 Subcol·lecció dels textos subratllats d'estudi per apartat
      // Comentari planer per a no-programadors: Permet conservar els subratllats que el candidat aplica sobre les línies del temari oficial. També dividim les regles per assolir blindatge absolut i evitar interrupcions durant l'estudi.
      match /subratllats/{docId} {
        allow read, write: if isOwner(userId);
        allow read, write: if isAdmin();
      }

      // 1.6 Subcol·lecció d'anotacions i notes redactades a mano a mode de resum propi per l'opositor
      // Comentari planer per a no-programadors: Espai privat on l'opositor redacta conceptes o regles mnemotècniques sobre un subtema.
      match /resums_estudiant/{docId} {
        allow read, write: if isOwner(userId);
        allow read, write: if isAdmin();
      }

      // 1.7 Subcol·lecció de dades de dietes i paràmetres nutricionals individuals de l'usuari
      // Comentari planer per a no-programadors: Permet a cada opositor desar les seves preferències, dades de diari, respostes de qüestionari i calories diàries desitjades, evitant que altres usuaris puguin llegir o alterar la seva informació personal.
      match /dades_dietes/{docId} {
        allow read, write: if isOwner(userId);
        allow read, write: if isAdmin();
      }

      // 1.8 Subcol·lecció dels resultats i diagnòstics del Test Biodata de l'opositor
      // Comentari planer per a no-programadors: Permet a cada aspirant desar la nota del seu simulacre de Biodata (i el diagnòstic de les 10 competències) de forma 100% privada i recuperar-lo quan entri des de qualsevol ordinador o mòbil.
      match /resultats_biodata/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }

      // 1.9 Subcol·lecció de sessions d'entrevista i seguiment psicopedagògic de l'alumne
      // Comentari planer per a no-programadors: Permet als professors i psicòlegs enregistrar el contingut de les entrevistes, punts tractats, notes per a altres docents i preparació de classes.
      match /sessions_entrevista/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // 1.10 Subcol·lecció de plantilles personalitzades de classe per a aquest alumne concret
      match /plantilles_personalitzades/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // 1.11 Subcol·lecció de preparació de classes i esborranys per a aquest alumne
      match /preparacio_classes/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // 1.12 Estat de la pissarra d'entrevista en directe 1v1 (10 Competències Clau)
      // Comentari planer per a no-programadors: Permet a l'alumne i al professor interactuar de forma sincronitzada i en temps real durant una classe.
      match /entrevista_live_state/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // 1.13 Subcol·lecció de l'estat en curs / esborrany del Test Competencial i Biodata
      // Comentari planer per a no-programadors: Permet a l'alumne (com Marc Betriu i qualsevol altre) reprendre el seu examen en curs des d'on l'havia deixat amb totes les respostes i temps conservats.
      match /esborrany_test_competencial/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 1.13 Col·lecció global de plantilles genèriques de classes i simulacres per als professors (plantilles_classes)
    match /plantilles_classes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. Col·lecció de Rols i configuracions de permisos per a l'organització interna
    match /rols/{rolId} {
      // Qualsevol usuari autenticat pot llegir quins rols i permisos generals existeixen
      allow read: if isSignedIn();
      
      // Només l'administrador autenticat oficial d'OposiCAT pot modificar la taula de rols i permisos
      allow write: if isAdmin();
    }

    // 3. Historial de canvis d'auditoria de rols per als administradors (logs_rols)
    match /logs_rols/{logId} {
      allow read, write: if isAdmin();
    }

    // 4. Col·lecció global de Notificacions enviades i programades de l'administració
    match /notificacions/{notificacioId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // Comentari planer per a no-programadors: Permetem que qualsevol client (inclòs el nostre vigilant de segon pla) marqui una notificació programada existent com a 'ENVIAR' per arxivar-la un cop entregada, impedint alterar mai el contingut inicial o la resta de dades descriptives.
        existing().accio == "PROGRAMAR" &&
        incoming().accio == "ENVIAR" &&
        incoming().titol == existing().titol &&
        incoming().cos == existing().cos
      );
    }

    // 5. Nova col·lecció global de registre de tokens FCM reals dels mòbils (fcm_tokens)
    match /fcm_tokens/{tokenId} {
      // Comentari planer per a no-programadors: Permetem llegir els tokens de forma lliure per facilitar que el nostre vigilant automàtic en segon pla (el qual s'executa en el servidor sense tenir cap sessió d'usuari iniciada) pugui recuperar els receptors i retransmetre els missatges a tots els opositors.
      allow read: if true;
      allow create: if isSignedIn() &&
                       isValidId(tokenId) &&
                       isValidFCMToken(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().email == request.auth.token.email &&
                       incoming().creadaEl == request.time;
      allow update: if (isSignedIn() &&
                       isValidId(tokenId) &&
                       isValidFCMToken(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       existing().userId == request.auth.uid &&
                       incoming().email == request.auth.token.email &&
                       incoming().creadaEl == existing().creadaEl) || 
                       isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 6. Col·lecció de banc de preguntes globals (permetem llegir de forma lliure per evitar errors de càrrega)
    // Comentari planer per a no-programadors: Deixem llegir les preguntes de l'examen a qualsevol persona que entri, ja que són dades d'estudi públiques, però només deixem que els administradors oficials puguin modificar o crear preguntes noves.
    match /preguntes_codificades/{preguntaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Suport per a consultes CollectionGroup sobre preguntes_codificades
    // Comentari planer per a no-programadors: Això ajuda al cercador intern de l'aplicació a trobar qualsevol pregunta independentment de la carpeta o subtema on s'hagi guardat originalment.
    match /{path=**}/preguntes_codificades/{preguntaId} {
      allow read: if true;
    }

    // 7. Col·lecció de preguntes ordenades per exàmens oficials i simulacres
    // Comentari planer per a no-programadors: Les preguntes i respostes dels exàmens reals i simulacres s'han d'ensenyar tant als alumnes registrats com als usuaris de prova ràpida. Bloquegem l'escriptura per seguretat.
    match /examens/{examenId}/preguntes/{preguntaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Col·lecció d'Actualitat i Notícies de la Setmana
    // Comentari planer per a no-programadors: La llista de notícies, canvis de bases de convocatòria i novetats s'ha de poder llegir lliurement. Només es pot escriure per l'administració autoritzada de la web.
    match /actualitat/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Banc de preguntes d'actualitat relacionades a les notícies
    // Comentari planer per a no-programadors: Permet als opositors assajar preguntes basades en les darreres notícies i canvis legislatius d'OposiCAT.
    match /actualitat_preguntes/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Directori d'acadèmies i gimnasos de preparació física
    // Comentari planer per a no-programadors: Informació de suport amb els gimnasos col·laboradors per preparar les proves físiques. De lectura lliure, tancat d'escriptura als alumnes.
    match /gimnasos/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Reserves d'assessoria amb l'equip de psicologia clínica d'OposiCAT
    // Comentari planer per a no-programadors: Per demanar cita de simulacres d'entrevista amb psicòlegs, els alumnes registrats poden reservar de forma asíncrona un espai segur. Els administradors tenen accés total per coordinar-ho.
    match /reserves_psicologia/{documentId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // 12. Gestor de taules de subscripcions i llicències
    // Comentari planer per a no-programadors: Informació reservada d'ús purament intern que només pot consultar i gestionar l'equip d'administració de la plataforma.
    match /subscripcions/{documentId} {
      allow read, write: if isAdmin();
    }

    // 13. Banc d'actualització de tipus de psicotècnics d'OposiMossos (figures, sèries, orientació)
    // Comentari planer per a no-programadors: Definicions generals de les competències intel·lectuals necessàries dels tests psicotècnics.
    match /psicotecnics_tipus/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 14. Banc de preguntes psicotècniques d'oposició real
    // Comentari planer per a no-programadors: Les preguntes i exercicis psicotècnics s'exposen gratuïtament o sota subscripció.
    match /psicotecnics_preguntes/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 15. Banc de proves d'exercici físic (pressió sobre banc, llançament, cursa de llançadora)
    // Comentari planer per a no-programadors: Models i barems del que exigeix el cos de Mossos d'Esquadra en cada disciplina física d'accés.
    match /exercicis_fisics/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mossos_prova_fisica_exercicis/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 16. Plans d'entrenament programats setmana a setmana
    // Comentari planer per a no-programadors: Taules guiades d'entrenaments esportius setmanals adaptables per als alumnes de l'acadèmia.
    match /plans_entrenament/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mossos_plans_entrenament/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 17. Preguntes de biodata de tipus personal, laboral i corporatiu de policia
    // Comentari planer per a no-programadors: Preguntes del qüestionari biogràfic obligatori del procés selectiu (biodata). Llegit pel simulador de l'alumne i administrat pel backoffice.
    match /preguntes_biodata_personals/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preguntes_biodata_laborals/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preguntes_biodata_pgme/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 18. Historial d'assajos de preguntes cara a cara en l'entrevista d'accés
    // Comentari planer per a no-programadors: Base de preguntes preparatòries per a l'entrevista oral exhaustiva.
    match /preguntes_entrevista/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19. Col·lecció de seguiment de respostes d'opositors per poder analitzar el progrés fidedignament
    // Comentari planer per a no-programadors: Aquest és el calaix personal de respostes que cada alumne respon. Per privacitat i RGPD, un alumne només pot llegir (tant llistar-les totes com agafar-ne una de sola) i desar les seves pròpies respostes realitzades.
    match /usuaris/{userId}/respostes_preguntes/{preguntaId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) &&
                               isValidId(preguntaId) &&
                               incoming().preguntaId == preguntaId &&
                               (incoming().encertada == true || incoming().encertada == false) &&
                               incoming().respostaSeleccionada is int &&
                               incoming().intents is int &&
                               incoming().correctes is int &&
                               incoming().errors is int;
      allow delete: if isAdmin();
    }

    // 20. Estructura de Temari d'Estudi d'OposiCAT
    // Comentari planer per a no-programadors: Permet a qualsevol persona llegir els temaris de Mossos d'Esquadra i les preguntes codificades associades, però restringeix qualsevol petició d'escriptura (creació, actualització i esborrat) exclusivament al personal d'administració autoritzat.
    match /temari/{anyDoc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 21. Comptadors globals de preguntes i temes (comptadors)
    // Comentari planer per a no-programadors: Permet que qualsevol alumne llegeixi lliurement els totals de preguntes dels diferents temes per així determinar correctament i de forma automàtica els seus percentatges de superació o estadístiques des del primer minut sense bloquejos d'antiga d'autenticació. Els canvis d'escriptura queden reservats només per als administradors d'OposiCAT.
    match /comptadors/{comptadorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 22. Preguntes de biodata oficial
    // Comentari planer per a no-programadors: Preguntes oficials del test de biodata, accessibles per a tots els alumnes per poder fer el test, i administrades pels administradors del backoffice.
    match /preguntes_biodata_oficial/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 23. Resultats del test de biodata desats a la base de dades
    // Comentari planer per a no-programadors: Desat i llegit per l'alumne, o per l'administrador/psicòleg.
    match /usuaris/{userId}/resultats_biodata/{resultatId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 24. Banc d'Aliments d'OposiCAT
    // Comentari planer per a no-programadors: Permet a qualsevol persona de l'aplicació llegeir la llista d'aliments saludables que formen part de la dieta oficial, però només els administradors podran afegir aliments nous, editar els macronutrients o esborrar-los de la base de dades.
    match /aliments/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 25. Diaris i Taules de Dietes d'OposiCAT
    // Comentari planer per a no-programadors: Permet a qualsevol estudiant o usuari llegir les dietes oficials creades i publicades per l'acadèmia. Únicament el personal d'administració autoritzat pot donar-les d'alta o esborrar-les.
    match /dietes/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 26. Feedback de Dieta dels Usuaris
    // Comentari planer per a no-programadors: Permet a qualsevol estudiant o opositor registrar la seva incidència o dubte respecte d'aliments o dietes d'OposiCAT, de manera segura, i restringeix l'escriptura (resposta) i esborrat exclusivament al personal d'administració autoritzat d'OposiCAT.
    match /notificacions_dietes/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.usuariId == request.auth.uid);
      allow create: if (isSignedIn() && isValidId(docId) && isValidDietaFeedback(incoming()) && incoming().usuariId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // 27. Propostes de gimnasos enviades pels usuaris o propietaris
    // Comentari planer per a no-programadors: Permet que qualsevol persona pugui enviar una nova proposta (creació) si les dades són totalment vàlides i estructurades. Si l'usuari té la sessió iniciada, enllacem la proposta amb el seu compte per a que la pugui consultar. Si és un usuari extern o no-autenticat, la desarà amb l'identificador 'anonim'. Els administradors del web d'OposiCAT sempre tindran dret a gestionar i validar les propostes.
    match /propostes_gimnasos/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.usuariId == request.auth.uid);
      allow create: if (
        isValidId(docId) && 
        isValidPropostaGimnas(incoming()) && 
        (!isSignedIn() ? incoming().usuariId == "anonim" : incoming().usuariId == request.auth.uid)
      ) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // 28. Gimnasos o Centres d'Entrenament Oficials d'OposiCAT
    // Comentari planer per a no-programadors: Permet a qualsevol persona llegir la llista de gimnasos homologats i col·laboradors oficials per a les proves físiques de Mossos. Només el personal d'administració autoritzat pot donar d'alta, editar dades o esborrar els gimnasos.
    match /gimnasos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
