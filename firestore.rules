rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role-based helper from a trusted document and trusted list of admins (runtime emails)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "xepfarre@gmail.com" ||
        request.auth.token.email == "sergivinu@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == "admin")
      );
    }

    // Validation helper for Usuari (Zero-Trust Anti-Update-Gap)
    function isValidUsuari(data) {
      return data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.rol is string && (data.rol == "usuari" || data.rol == "admin") &&
             (!("nom" in data) || (data.nom is string && data.nom.size() <= 128));
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      // Allow single read and update/delete
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Users should not query the entire list of users

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['uid', 'email', 'rol', 'createdAt', 'updatedAt']) &&
                       (incoming().keys().size() == 5 || (incoming().keys().size() == 6 && "nom" in incoming())) &&
                       isValidUsuari(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time &&
                       incoming().rol == "usuari"; // Standard sign-up defaults to standard role

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['uid', 'email', 'rol', 'createdAt', 'updatedAt']) &&
                       (incoming().keys().size() == 5 || (incoming().keys().size() == 6 && "nom" in incoming())) &&
                       isValidUsuari(incoming()) &&
                       incoming().updatedAt == request.time &&
                       // Immutable fields check
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Prevents standard users from escalating their own role
                         incoming().rol == existing().rol ||
                         // Admins are permitted to change roles
                         isAdmin()
                       );

      allow delete: if isAdmin();
    }
  }
}
